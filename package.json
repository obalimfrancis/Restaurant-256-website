{
  "name": "restaurant-website",
  "version": "2.0.0",
  "private": true,
  "description": "Mr. Tasty — a static restaurant site with an online menu, order builder and table reservations.",
  "author": "OBALIM FRANCIS",
  "license": "ISC",
  "scripts": {
    "build:css": "tailwindcss -i ./tailwind.src.css -o ./tailwind.build.css --minify",
    "watch:css": "tailwindcss -i ./tailwind.src.css -o ./tailwind.build.css --watch",
    "dev": "npm run watch:css",
    "serve": "npx --yes serve . -l 5173",
    "build": "npm run build:css"
  },
  "keywords": ["restaurant", "static-site", "tailwindcss"],
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
